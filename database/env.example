# Database Configuration
POSTGRES_DB=taskweight
POSTGRES_USER=taskweight_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# PgAdmin Configuration
PGADMIN_EMAIL=admin@taskweight.com
PGADMIN_PASSWORD=your_pgadmin_password_here
PGADMIN_PORT=8080

# Redis Configuration
REDIS_PASSWORD=your_redis_password_here
REDIS_PORT=6379

# Connection Settings
DATABASE_URL=postgresql://taskweight_user:your_secure_password_here@localhost:5432/taskweight
REDIS_URL=redis://:your_redis_password_here@localhost:6379/0

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *
BACKUP_PATH=/backup

# Monitoring
ENABLE_MONITORING=true
METRICS_PORT=9090
