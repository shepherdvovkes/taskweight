# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database Configuration
DATABASE_URL=postgresql://taskweight_user:taskweight_password@localhost:5432/taskweight
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=taskweight
DATABASE_USER=taskweight_user
DATABASE_PASSWORD=taskweight_password

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production

# Trello Integration (optional)
TRELLO_API_KEY=your-trello-api-key
TRELLO_API_SECRET=your-trello-api-secret

# Jira Integration (optional)
JIRA_URL=your-jira-instance-url
JIRA_USERNAME=your-jira-username
JIRA_API_TOKEN=your-jira-api-token
